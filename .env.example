# ============================================================
# Скопируй в .env и заполни своими значениями.
# НИКОГДА не коммить .env в git — он уже в .gitignore.
# ============================================================

# --- Активы ---
# Через запятую. На каждый актив заводится независимый поток по каждому
# таймфрейму (15m и 1h — см. src/timeframes.py), итого ASSETS x 2 потоков.
ASSETS=btc,eth,sol,bnb,hype,xrp

# --- Таймфреймы ---
# Через запятую: "5m", "15m", "1h" или комбинация. По умолчанию только 15m —
# 5m и 1h стратегии в коде остались (см. src/timeframes.py), просто сейчас
# выключены. Чтобы вернуть — допиши нужную метку сюда, без правки кода.
ENABLED_TIMEFRAMES=15m

# --- Источник цены/индикаторов (Binance, публичный API, ключ не нужен) ---
BINANCE_BASE_URL=https://api.binance.com
# Фолбэк для монет без спотовой пары на обычном Binance (на момент
# написания это под вопросом для HYPE — есть точно на фьючерсах).
BINANCE_FUTURES_URL=https://fapi.binance.com
ATR_LOOKBACK_FOR_REGIME=60

# --- Настройки таймфрейма 5m (НЕПРОВЕРЕННЫЕ на реальных данных догадки,
# пропорционально пересчитанные из 15m — присматривайся к первым отчётам) ---
# TF_5M_KLINE_INTERVAL=1m
# TF_5M_ATR_PERIOD=7
# TF_5M_EMA_FAST=3
# TF_5M_EMA_SLOW=7
# TF_5M_MIN_MINUTES_LEFT=1
# TF_5M_MAX_MINUTES_LEFT=3.5
# TF_5M_ATR_DISTANCE_MULT=1.5
# TF_5M_ATR_SPIKE_MULT=2.2
# TF_5M_POLL_SECONDS=3

# --- Настройки таймфрейма 15m (можно не трогать — разумные дефолты) ---
# TF_15M_KLINE_INTERVAL=1m
# TF_15M_ATR_PERIOD=14
# TF_15M_EMA_FAST=9
# TF_15M_EMA_SLOW=21
# TF_15M_MIN_MINUTES_LEFT=2
# TF_15M_MAX_MINUTES_LEFT=9
# TF_15M_ATR_DISTANCE_MULT=1.5
# TF_15M_ATR_SPIKE_MULT=2.2
# TF_15M_POLL_SECONDS=5

# --- Настройки таймфрейма 1h ---
# Индикаторы на 5-минутных свечах (не 1-минутных) — соразмерно часовому
# окну. Окно входа шире и позже: 10-45 из 60 минут вместо 2-9 из 15.
# TF_1H_KLINE_INTERVAL=5m
# TF_1H_ATR_PERIOD=14
# TF_1H_EMA_FAST=9
# TF_1H_EMA_SLOW=21
# TF_1H_MIN_MINUTES_LEFT=10
# TF_1H_MAX_MINUTES_LEFT=45
# TF_1H_ATR_DISTANCE_MULT=1.3
# TF_1H_ATR_SPIKE_MULT=2.2
# TF_1H_POLL_SECONDS=20

# --- Polymarket / CLOB ---
POLY_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
POLY_CHAIN_ID=137
# Приватный ключ кошелька, которым торгуешь. ДЕРЖИ В СЕКРЕТЕ.
# Рекомендуется отдельный "торговый" кошелёк, а не основной.
POLY_PRIVATE_KEY=
# Нужен, только если торгуешь не с адреса, выведенного из приватного ключа
# (например, отдельный кошелёк на Polymarket). В большинстве случаев,
# включая email/Magic-логин, можно оставить пустым — SDK сам разберётся.
POLY_FUNDER_ADDRESS=
# Больше не используется (актуальный SDK polymarket-client сам определяет
# тип кошелька) — оставлено на случай отката на другой клиент.
POLY_SIGNATURE_TYPE=0

# --- Диапазон входа (общий для всех активов/таймфреймов) ---
MIN_ENTRY_PRICE=0.80
MAX_ENTRY_PRICE=0.95

# --- Пороги безопасности (общие; регулируется и кнопкой ⚙️ в Telegram) ---
SAFETY_SCORE_THRESHOLD=75
MIN_BOOK_LIQUIDITY_USDC=25

# --- Латентность исполнения ---
# Живой WS-стакан вместо REST-поллинга при каждом тике (см. src/book_stream.py).
USE_LIVE_BOOK_STREAM=true
# Запас на слиппедж поверх цены ask, увиденной на сигнале, на случай, если
# книга Polymarket успеет уйти за время между решением и отправкой ордера.
LIVE_ENTRY_MAX_SLIPPAGE=0.01
# Жёсткий потолок цены исполнения — даже с учётом слиппеджа никогда не
# платим больше этого, что бы ни случилось со стаканом.
MAX_ENTRY_EXECUTION_PRICE=0.97

# --- Управление капиталом ---
TRADE_SIZE_USDC=2
# Общий потолок ОДНОВРЕМЕННО открытых позиций по ВСЕМ активам/таймфреймам —
# без него при 12 параллельных потоках несколько сигналов могут совпасть
# по времени и открыть много позиций разом.
MAX_OPEN_POSITIONS=2
# Ниже этой суммы даже не пытаемся входить — если в стакане меньше объёма
# по нужной цене, тик тихо пропускается (это не ошибка, просто неликвидно).
MIN_VIABLE_TRADE_USDC=2
DAILY_LOSS_LIMIT_USDC=6

# --- Масштабирование ставки по уверенности сигнала ---
# При score == порогу ставка = TRADE_SIZE_USDC * MIN_FRACTION; при score >=
# MAX_SCORE — полный TRADE_SIZE_USDC. Между ними — линейно. Включается/
# выключается кнопкой в Telegram (⚙️ Настройки), по умолчанию выключено.
SIZE_SCALING_MIN_FRACTION=0.3
SIZE_SCALING_MAX_SCORE=95

# --- Режим работы ---
# ОБЯЗАТЕЛЬНО прогони бота в DRY_RUN=true как минимум несколько дней и
# посмотри на signals в базе, прежде чем включать реальные сделки.
DRY_RUN=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
DB_PATH=data/bot.db

# --- Отчёты для анализа стратегии ---
# Каждые N часов бот сам присылает в Telegram два CSV (сигналы + сделки)
# по ВСЕМ активам и таймфреймам разом — разбивка по колонкам asset/timeframe.
REPORT_INTERVAL_HOURS=4
REPORTS_DIR=data/reports

# --- Отслеживание чужого кошелька (уведомления + опциональный копитрейдинг) ---
WALLET_TRACK_ADDRESS=0x4707b735acce66b2ccb5600086de2329685cd1ce
WALLET_TRACK_POLL_SECONDS=3
