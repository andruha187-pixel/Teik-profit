TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=8080
DATA_DIR=/var/data

# Real Polymarket execution wallet.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=

# Hard LIVE master. Keep 0 while testing PAPER.
LIVE_MASTER_ENABLE=0

# Telegram-editable BUY sizing defaults.
# Modes: FIXED, SAME_USD, SAME_SHARES, SCALE
COPY_SIZE_MODE=FIXED
COPY_USDC=5
COPY_SCALE_PCT=100
MAX_COPY_USDC=100
COPY_SLIPPAGE=0.05
COPY_SELL_MODE=PROPORTIONAL
PAPER_START_BALANCE=500

# Fast feed + fallback.
RTDS_URL=wss://ws-live-data.polymarket.com
REST_FALLBACK_ENABLE=1
REST_FALLBACK_INTERVAL=1.0
REST_MAX_COPY_AGE_SEC=4
MAX_WALLETS=20

# Execution.
MIN_ORDER_SHARES=5
MAX_ORDER_SHARES=10000
LIVE_PRICE_TICK_FALLBACK=0.01
LIVE_PREWARM_ENABLE=1
LIVE_PREWARM_INTERVAL_SEC=20
LIVE_NO_MATCH_RETRIES=1
LIVE_NO_MATCH_RETRY_DELAY_MS=25
LIVE_SELL_BALANCE_RETRY_MS=600

TELEGRAM_NOTIFY_TRADES=1
LOG_LEVEL=INFO
