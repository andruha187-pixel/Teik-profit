# ============================================================
# TELEGRAM / HOSTING
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PORT=8080
DATA_DIR=/var/data
LOG_LEVEL=INFO

SYMBOLS=BTC,XRP,BNB,SOL,ETH,DOGE,HYPE

# ============================================================
# EXTERNAL SOURCES
# Keep these unchanged so score 0.40 / 0.42 is comparable with prior data.
# ============================================================
ENABLE_BINANCE=1
ENABLE_BYBIT=1
ENABLE_COINBASE=1
COINBASE_PRODUCTS=BTC:BTC-USD,ETH:ETH-USD,SOL:SOL-USD,XRP:XRP-USD,DOGE:DOGE-USD

BINANCE_WS_BASE=wss://fstream.binance.com/public/stream
BYBIT_WS=wss://stream.bybit.com/v5/public/linear
COINBASE_WS=wss://advanced-trade-ws.coinbase.com
SOURCE_FRESH_MS=2500

# ============================================================
# LAB SAMPLING / WINDOW
# ============================================================
FAST_INTERVAL=0.25
FEATURE_PERSIST_INTERVAL=0.50
FEATURE_HISTORY_SECONDS=45
TRADE_WINDOW_SECONDS=180

# ============================================================
# ACTIVE PAPER STRATEGIES: 4-way score/timing forward test
# ============================================================
EXT_VOTE_THRESHOLD=0.25
PREJUMP_PRICE_MIN=0.52
PREJUMP_PRICE_MAX=0.66
PREJUMP_SCORE=0.40
PREJUMP_HIGH_SCORE=0.42
PREJUMP_MIN_VENUES=2
PREJUMP_MIN_ELAPSED=1
PREJUMP_MAX_ELAPSED=160
PREJUMP_TEST_MIN_ELAPSED=10
PREJUMP_TEST_MAX_ELAPSED=120
PREJUMP_PM_MOM_MIN=-0.01
PREJUMP_PM_MOM_MAX=0.05
PREJUMP_REQUIRE_BINANCE_BYBIT=0

# ============================================================
# JUMP LABELS / PAPER EXECUTION
# ============================================================
JUMP_MOVE=0.08
JUMP_WINDOW_SEC=5
JUMP_COOLDOWN_SEC=10

PAPER_START_BALANCE=500
ENTRY_ORDER_SIZE=5
MIN_FREE_CASH=5
TAKE_PROFIT_USDC=0.60
CRYPTO_FEE_RATE=0.07
MIN_PRICE=0.08
MAX_PRICE=0.95
MAX_BOOK_AGE_MS=1000

# ============================================================
# POLYMARKET / REPORT / STABILITY
# ============================================================
DISCOVERY_INTERVAL=10
REPORT_DELAY_SECONDS=300
REPORT_CHECK_INTERVAL=30
WS_MAX_CONNECTION_AGE_SEC=900
MEMORY_CLEANUP_INTERVAL=60
MEMORY_KEEP_RESOLVED_SEC=900

# ============================================================
# EXPERIMENTAL EARLY / LEAD PAPER BRANCH
# Existing 4 PRE_JUMP controls are unchanged.
# PRE_LEAD predicts the normal 0.40 crossing ~300ms ahead, then
# simulates a 250ms Polymarket taker hold before PAPER execution.
# ============================================================
LEAD_INTERVAL=0.10
PRELEAD_MIN_SCORE=0.34
PRELEAD_TARGET_SCORE=0.40
PRELEAD_LOOKBACK_MS=300
PRELEAD_HORIZON_MS=300
PRELEAD_MIN_DELTA=0.015
PRELEAD_HISTORY_TOLERANCE_MS=180
PRELEAD_MIN_VENUES=2
PRELEAD_MIN_ELAPSED=1
PRELEAD_MAX_ELAPSED=160
PRELEAD_PRICE_MIN=0.52
PRELEAD_PRICE_MAX=0.66
PRELEAD_PM_MOM_MIN=-0.01
PRELEAD_PM_MOM_MAX=0.05
PRELEAD_SIM_DELAY_MS=250
PRELEAD_SIM_MAX_SLIPPAGE=0.05

# ============================================================
# FROZEN PRE_LEAD_SAFE FORWARD TEST
# Same PRE_LEAD candidate + these two extra gates only.
# Do not tune during the next forward sample.
# ============================================================
PRELEAD_SAFE_PROJECTED_SCORE=0.55
PRELEAD_SAFE_PRICE_MAX=0.56

# ============================================================
# PRE_LEAD_CONFIRM FORWARD TEST
# First PRE_LEAD_SAFE candidate is binding. Wait briefly, then require
# same-direction score to persist before starting the normal 250ms delay.
# ============================================================
PRELEAD_CONFIRM_MS=125
PRELEAD_CONFIRM_MAX_SCORE_FADE=0.01
PRELEAD_CONFIRM_PRICE_MAX=0.56
PRELEAD_CONFIRM_MIN_VENUES=2
