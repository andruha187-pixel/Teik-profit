# ============================================================
# TELEGRAM / HOSTING
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PORT=8080
DATA_DIR=/var/data
LOG_LEVEL=INFO

# Tokens used by the strategy.
SYMBOLS=BTC,XRP,BNB,SOL,ETH,DOGE,HYPE

# ============================================================
# PRE-JUMP — default settings from the forward test
# Telegram can raise/lower SCORE at runtime, but never below 0.40.
# ============================================================
PREJUMP_SCORE=0.40
PREJUMP_PRICE_MIN=0.52
PREJUMP_PRICE_MAX=0.66
PREJUMP_MIN_VENUES=2
PREJUMP_MIN_ELAPSED=1
PREJUMP_MAX_ELAPSED=160
PREJUMP_PM_MOM_MIN=-0.01
PREJUMP_PM_MOM_MAX=0.05
PREJUMP_REQUIRE_BINANCE_BYBIT=0

# BTC-only FIRST normal PRE-JUMP candidate filter.
# The first otherwise-valid BTC 0.40 signal must also satisfy BOTH; otherwise
# that 5-minute BTC market is skipped and the bot will NOT wait for a later 0.43 signal.
BTC_PREJUMP_SCORE=0.43
BTC_PREJUMP_PRICE_MAX=0.55

# Additional token-specific FIRST normal PRE-JUMP candidate filters.
# Failure closes that 5-minute market; the bot does not wait for a later signal.
SOL_PREJUMP_PM_MOM_MAX=0.02
XRP_PREJUMP_SCORE=0.41
BNB_PREJUMP_PM_MOM_MIN=0.01
DOGE_PREJUMP_MAX_SPREAD=0.02

# ETH-only FIRST normal PRE-JUMP candidate filter. BOTH must pass.
# HYPE intentionally has no additional SAFE filter.
ETH_PREJUMP_SCORE=0.455
ETH_PREJUMP_PM_MOM_MAX=0.02

EXT_VOTE_THRESHOLD=0.25
SOURCE_FRESH_MS=2500
FAST_INTERVAL=0.10
EVENT_DRIVEN_LIVE_ENTRY=1
EVENT_DRIVEN_MIN_INTERVAL_MS=5

# ============================================================
# EXECUTION
# ============================================================
ENTRY_ORDER_SIZE=5
TAKE_PROFIT_USDC=0.60
PAPER_START_BALANCE=500
MIN_FREE_CASH=5
CRYPTO_FEE_RATE=0.07
MAX_BOOK_AGE_MS=1000
LIVE_MIN_SHARES=0.01
LIVE_MAX_SHARES_PER_ORDER=1000

# Fast PRE-JUMP LIVE entry protection/retry.
# FAK NO_MATCH is a deterministic zero fill, so one controlled retry is safe.
LIVE_ENTRY_MAX_SLIPPAGE=0.05
LIVE_ENTRY_NO_MATCH_RETRIES=1
LIVE_ENTRY_RETRY_DELAY_MS=0
LIVE_ENTRY_RETRY_FORCE_REST=0
LIVE_ENTRY_FORCE_REST_BOOK=0
LIVE_PREWARM_ENABLE=1
LIVE_PREWARM_INTERVAL_SEC=30
LIVE_PREWARM_LEAD_SEC=3
LIVE_PRESIGN_PREWARM_ENABLE=1
LIVE_PRESIGN_PREWARM_LEAD_SEC=12
LIVE_PRESIGN_PREWARM_SIZE=5
LIVE_PRICE_TICK_FALLBACK=0.01

# LIVE TP: wait briefly for newly bought outcome shares to become sellable.
LIVE_TP_MIN_HOLD_MS=2000
LIVE_TP_BALANCE_RETRY_DELAY_MS=1000

# ============================================================
# LIVE SAFETY / WALLET
# Keep LIVE_MASTER_ENABLE=0 until WALLET says READY.
# NEVER commit the private key to GitHub.
# ============================================================
LIVE_MASTER_ENABLE=0
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# ============================================================
# PUBLIC EXTERNAL DATA SOURCES
# ============================================================
ENABLE_BINANCE=1
ENABLE_BYBIT=1
ENABLE_COINBASE=1
COINBASE_PRODUCTS=BTC:BTC-USD,ETH:ETH-USD,SOL:SOL-USD,XRP:XRP-USD,DOGE:DOGE-USD
BINANCE_WS_BASE=wss://fstream.binance.com/public/stream
BYBIT_WS=wss://stream.bybit.com/v5/public/linear
COINBASE_WS=wss://advanced-trade-ws.coinbase.com

# Runtime load controls
TP_CHECK_INTERVAL=0.75
TRAJECTORY_INTERVAL=3.0
DISCOVERY_INTERVAL=10
WS_MAX_CONNECTION_AGE_SEC=900
MEMORY_CLEANUP_INTERVAL=60
MEMORY_KEEP_RESOLVED_SEC=900
MEMORY_LOG_INTERVAL=300
