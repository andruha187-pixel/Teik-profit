# ============================================================
# TELEGRAM
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# HOSTING / STORAGE
# ============================================================
PORT=8080
DATA_DIR=/var/data
LOG_LEVEL=INFO
SYMBOLS=BTC,XRP,BNB,SOL,ETH,DOGE,HYPE

# ============================================================
# PAPER
# ============================================================
PAPER_START_BALANCE=500
MIN_FREE_CASH=5

# ============================================================
# LIVE SAFETY
# First deploy with 0. Verify WALLET -> SDK READY, wallet, collateral.
# Then change to 1 and redeploy.
# ============================================================
LIVE_MASTER_ENABLE=0

# Default 0: only ONE A/B/C/E strategy per token may be LIVE at once.
# Set 1 only if you deliberately want several independent real orders
# on the same token/5-minute market.
ALLOW_MULTI_LIVE_PER_TOKEN=0

LIVE_MIN_SHARES=0.01
LIVE_MAX_SHARES_PER_ORDER=1000

# ============================================================
# POLYMARKET WALLET
# Keep the real private key ONLY in hosting secrets/environment.
# Never commit it to GitHub.
# ============================================================
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=

# Optional. Leave blank unless your wallet setup specifically uses them.
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# ============================================================
# TAKE PROFIT
# DEFAULT = +$0.60 NET for the WHOLE remaining position.
# Entry fees + estimated executable exit fees are included.
# Examples: 0.30, 0.60, 1.00
# OFF / NONE / DISABLED / 0 = disable.
# ============================================================
TAKE_PROFIT_USDC=0.60

# ============================================================
# COMMON SAFE67 ENGINE
# ============================================================
DECISION_INTERVAL=3.0
TRADE_WINDOW_SECONDS=180
ENTRY_ORDER_SIZE=5
DCA_ORDER_SIZE=5
ENTRY_MOVE=0.03
LOOKBACK_TICKS=2

V2_ELIGIBLE_PRICE_MIN=0.55
V2_ELIGIBLE_PRICE_MAX=0.75
V2_ELIGIBLE_MOM_MIN=0.03
V2_ELIGIBLE_MOM_MAX=0.30

# A / B / E entry
SAFE_ENTRY_PRICE_MIN=0.67
SAFE_ENTRY_PRICE_MAX=0.75
SAFE_ENTRY_MOM_MIN=0.05
SAFE_ENTRY_MOM_MAX=0.10

# B old reversal DCA
DCA_ARM_PRICE=0.50
DCA_MAX_BUY_PRICE=0.60
DCA_REBOUND_MOM=0.05
DCA_DEADLINE_SEC=120

# C tighter entry + safer DCA
C_SAFE_ENTRY_PRICE_MIN=0.67
C_SAFE_ENTRY_PRICE_MAX=0.70
C_DCA_MIN_BUY_PRICE=0.30
C_DCA_MAX_BUY_PRICE=0.60
C_DCA_REBOUND_MOM_MIN=0.05
C_DCA_REBOUND_MOM_MAX=0.15

# E cross-token A/BASE confirmation
CONSENSUS_WINDOW_SEC=10
CONSENSUS_MIN_OTHER_TOKENS=2

# No stop-loss
MIN_PRICE=0.08
MAX_PRICE=0.95

CRYPTO_FEE_RATE=0.07
DISCOVERY_INTERVAL=10
MAX_BOOK_AGE_MS=1000

MEMORY_CLEANUP_INTERVAL=60
MEMORY_KEEP_RESOLVED_SEC=900
WS_MAX_CONNECTION_AGE_SEC=900
MEMORY_LOG_INTERVAL=300
