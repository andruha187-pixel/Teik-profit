# ============================================================
# TELEGRAM / HOSTING
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PORT=8080
DATA_DIR=/var/data
LOG_LEVEL=INFO

SYMBOLS=BTC,XRP,BNB,SOL,ETH,DOGE,HYPE

# ============================================================
# EXTERNAL SOURCES — public market data, no exchange API keys
# ============================================================
ENABLE_BINANCE=1
ENABLE_BYBIT=1
ENABLE_COINBASE=1

# Coinbase does not need to cover every token. Add/remove products if desired.
COINBASE_PRODUCTS=BTC:BTC-USD,ETH:ETH-USD,SOL:SOL-USD,XRP:XRP-USD,DOGE:DOGE-USD

# 2026 Binance USD-M public high-frequency endpoint.
BINANCE_WS_BASE=wss://fstream.binance.com/public/stream
BYBIT_WS=wss://stream.bybit.com/v5/public/linear
COINBASE_WS=wss://advanced-trade-ws.coinbase.com

# Source freshness for scoring.
SOURCE_FRESH_MS=2500

# ============================================================
# LAB SAMPLING
# ============================================================
# External features / PRE_JUMP decisions every 250 ms.
FAST_INTERVAL=0.25
# Persist research features every 500 ms to keep hourly ZIP manageable.
FEATURE_PERSIST_INTERVAL=0.50
FEATURE_HISTORY_SECONDS=45

# Current SAFE67 benchmark remains on ~3 second decisions.
BASE_DECISION_INTERVAL=3.0
TRADE_WINDOW_SECONDS=180
LOOKBACK_TICKS=2

# ============================================================
# CURRENT SAFE67 BENCHMARK
# ============================================================
V2_ELIGIBLE_PRICE_MIN=0.55
V2_ELIGIBLE_PRICE_MAX=0.75
V2_ELIGIBLE_MOM_MIN=0.03
V2_ELIGIBLE_MOM_MAX=0.30

SAFE_ENTRY_PRICE_MIN=0.67
SAFE_ENTRY_PRICE_MAX=0.75
SAFE_ENTRY_MOM_MIN=0.05
SAFE_ENTRY_MOM_MAX=0.10

# ============================================================
# EXTERNAL MICROSTRUCTURE HYPOTHESES
# These are PAPER research thresholds, not claimed optimums.
# ============================================================
EXT_VOTE_THRESHOLD=0.25

# EXT_CONFIRM: SAFE67 + same-direction external confirmation.
EXT_CONFIRM_SCORE=0.30
EXT_CONFIRM_MIN_VENUES=2

# EXT_VETO: block a SAFE67 entry if external order flow strongly opposes it.
EXT_VETO_SCORE=-0.20
EXT_VETO_MIN_OPPOSING_VENUES=2

# PRE_JUMP: enter before SAFE67 if external microstructure is very strong.
PREJUMP_PRICE_MIN=0.52
PREJUMP_PRICE_MAX=0.66
PREJUMP_SCORE=0.55
PREJUMP_MIN_VENUES=2
PREJUMP_MIN_ELAPSED=5
PREJUMP_MAX_ELAPSED=160
PREJUMP_PM_MOM_MIN=-0.01
PREJUMP_PM_MOM_MAX=0.05
# 1 = Binance AND Bybit must both vote in the PRE_JUMP direction.
PREJUMP_REQUIRE_BINANCE_BYBIT=1

# ============================================================
# JUMP LABELS
# A jump = Polymarket outcome ASK rises by >= 0.08 within 5 seconds.
# The report stores external state 1/3/5/10/20 sec BEFORE the jump.
# ============================================================
JUMP_MOVE=0.08
JUMP_WINDOW_SEC=5
JUMP_COOLDOWN_SEC=10

# ============================================================
# PAPER EXECUTION / TARGET
# ============================================================
PAPER_START_BALANCE=500
ENTRY_ORDER_SIZE=5
MIN_FREE_CASH=5
TAKE_PROFIT_USDC=0.60
CRYPTO_FEE_RATE=0.07
MIN_PRICE=0.08
MAX_PRICE=0.95
MAX_BOOK_AGE_MS=1000

# ============================================================
# POLYMARKET / REPORT / STABILITY
# ============================================================
DISCOVERY_INTERVAL=10
REPORT_DELAY_SECONDS=300
REPORT_CHECK_INTERVAL=30
WS_MAX_CONNECTION_AGE_SEC=900
MEMORY_CLEANUP_INTERVAL=60
MEMORY_KEEP_RESOLVED_SEC=900
