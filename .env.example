TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=8080
DATA_DIR=/var/data

# Real Polymarket execution wallet.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=

# Hard LIVE master. Keep 0 while testing PAPER.
LIVE_MASTER_ENABLE=0

# Telegram-editable BUY sizing defaults.
# Modes: FIXED, SAME_USD, SAME_SHARES, SCALE
COPY_SIZE_MODE=FIXED
COPY_USDC=5
COPY_SCALE_PCT=100
MAX_COPY_USDC=100
COPY_SLIPPAGE=0.05
COPY_SELL_MODE=PROPORTIONAL
PAPER_START_BALANCE=500

# Fast feed + fallback.
RTDS_URL=wss://ws-live-data.polymarket.com
REST_FALLBACK_ENABLE=1
REST_FALLBACK_INTERVAL=0.5
REST_MAX_COPY_AGE_SEC=30
REST_AUDIT_LOOKBACK_SEC=300
REST_ACTIVITY_ENABLE=1
REST_ACTIVITY_INTERVAL=1.0
MAX_WALLETS=20

# Execution.
MIN_ORDER_SHARES=5
MAX_ORDER_SHARES=10000
LIVE_PRICE_TICK_FALLBACK=0.01
LIVE_PREWARM_ENABLE=1
LIVE_PREWARM_INTERVAL_SEC=20
LIVE_NO_MATCH_RETRIES=1
LIVE_NO_MATCH_RETRY_DELAY_MS=25
LIVE_SELL_BALANCE_RETRY_MS=600

TELEGRAM_NOTIFY_TRADES=1
LOG_LEVEL=INFO

# BTC 15m prewarmed fast lane (NO pre-copy).
BTC15_FASTLANE_ENABLE=1
BTC15_SLUG_PREFIX=btc-updown-15m
BTC15_DISCOVERY_INTERVAL_SEC=2
BTC15_BOOK_MAX_AGE_MS=1500
BTC15_SIGNER_PREWARM_ENABLE=1
BTC15_SIGNER_PREWARM_SIZE=5
BTC15_SIGNER_PREWARM_PRICE=0.50
BTC15_WS_MAX_AGE_SEC=240

# Durable LIVE delivery recovery. Runs AFTER the first fast FAK and never slows
# the initial detect -> submit path. It keeps the original slippage limit.
RECOVERY_ENABLE=1
RECOVERY_BOOK_POLL_MS=50
RECOVERY_FAK_RETRY_MS=250
RECOVERY_AMBIGUOUS_GRACE_MS=2500
RECOVERY_RECONCILE_INTERVAL_MS=250
RECOVERY_MAX_AGE_SEC=900
RECOVERY_OWN_TRADES_LIMIT=200
